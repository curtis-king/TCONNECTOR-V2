  "body": "<!DOCTYPE html><html lang='fr'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='referrer' content='no-referrer'><title>T-CONNECTOR &middot; compte/mot-de-passe</title><link rel=\"stylesheet\" href=\"/static/css/app.css\"><script src=\"/static/js/app.js\"></script></head><body><div class=\"sidebar\">\n  <div class=\"sidebar-top\">\n    <a href=\"/\" class=\"sidebar-logo\">\n      <div class=\"icon\">TC</div>\n      <span>T-CONNECTOR</span>\n    </a>\n    <button class=\"sidebar-toggle no-print\" onclick=\"toggleSidebar()\" aria-label=\"Replier le menu\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/></svg>\n    </button>\n  </div>\n  <ul class=\"sidebar-nav\"><li class=\"nav-label\">Principal</li><li><a href=\"/\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg></span><span class=\"label\">Dashboard</span></a></li><li><a href=\"/invoices\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg></span><span class=\"label\">Factures Sage</span></a></li><li><a href=\"/billing\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg></span><span class=\"label\">Facturation</span></a></li><li><a href=\"/pos\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg></span><span class=\"label\">Vente POS</span></a></li><li class=\"nav-label\">Gestion</li><li><a href=\"/clients\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg></span><span class=\"label\">Clients</span></a></li><li><a href=\"/sales\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><span class=\"label\">Historique</span></a></li><li><a href=\"/vendeurs\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span><span class=\"label\">Vendeurs</span></a></li><li><a href=\"/pending\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg></span><span class=\"label\">En attente</span></a></li><li><a href=\"/certified\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg></span><span class=\"label\">Certifiees</span></a></li><li><a href=\"/utilisateurs\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"label\">Utilisateurs</span></a></li><li><a href=\"/config\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"label\">Config</span></a></li><li><a href=\"/logout\" class=\"logout-link\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/></svg></span><span class=\"label\">Deconnexion</span></a></li></ul>\n  <div class=\"sidebar-foot\">\n    <div class=\"net-indicator\">\n      <span class=\"net-dot unknown\" id=\"net-dot\"></span>\n      <span id=\"net-label\" style=\"font-size:11px;font-weight:600\">...</span>\n    </div>\n  </div>\n</div>\n<div class=\"main-content\"><div class=\"topbar\"><div class=\"topbar-title\">compte/mot-de-passe</div><div class=\"topbar-actions\"><button class=\"btn btn-sm btn-primary no-print\" onclick=\"syncNow()\">Synchroniser</button><span class=\"user-chip\"><span class=\"ava\">A</span><span>admin@example.com<span style=\"color:#64748b;font-weight:500\"> &middot; Administrateur</span></span></span><a class=\"btn btn-sm btn-ghost no-print\" href=\"/compte/mot-de-passe\">Mot de passe</a><a class=\"btn btn-sm btn-ghost no-print\" href=\"/logout\">Deconnexion</a></div></div><script>window.CSRF_TOKEN=\"plKDfcq5Ba2nYxHaY9-Cfhm19ttV5NyiTJpbxjO1FpQ\";</script>\n<div class=\"card\" style=\"max-width:460px\"><h2>Changer mon mot de passe</h2>\n<form id=\"pwd-form\">\n<div><label>Mot de passe actuel</label><input type=\"password\" id=\"p-current\" required></div>\n<div><label>Nouveau mot de passe</label><input type=\"password\" id=\"p-new\" required minlength=\"8\"></div>\n<div><label>Confirmation</label><input type=\"password\" id=\"p-confirm\" required></div>\n<div style=\"margin-top:16px\"><button type=\"submit\" class=\"btn btn-primary\">Mettre a jour</button></div>\n</form>\n<p style=\"font-size:12px;color:#64748b;margin-top:12px\">Minimum 8 caracteres. Le mot de passe est hache (PBKDF2) et n'est jamais stocke en clair.</p>\n</div>\n<script>\ndocument.getElementById(\"pwd-form\").onsubmit=function(e){\ne.preventDefault();\nvar cur=document.getElementById(\"p-current\").value;\nvar nv=document.getElementById(\"p-new\").value;\nvar cf=document.getElementById(\"p-confirm\").value;\nif(nv!==cf){showToast(\"Les mots de passe ne correspondent pas\",\"err\");return;}\napi(\"POST\",\"/api/compte/password\",{current:cur,nouveau:nv}).then(function(r){\nif(r.success==false){showToast(r.error||\"Erreur\",\"err\");return;}\nshowToast(\"Mot de passe mis a jour\",\"ok\");document.getElementById(\"pwd-form\").reset();\n});\n};\n</script></div>\n<div class=\"alert-zone\" id=\"alert-zone\" aria-live=\"polite\"></div>\n</body></html>",
