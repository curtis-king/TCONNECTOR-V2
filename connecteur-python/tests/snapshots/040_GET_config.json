{
  "file": "040_GET_config.json",
  "endpoint": "config.config_page",
  "methods": [
    "GET"
  ],
  "path": "/config",
  "status_code": 200,
  "content_type": "text/html; charset=utf-8",
  "encoding": "text",
  "body": "<!DOCTYPE html><html lang='fr'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='referrer' content='no-referrer'><title>T-CONNECTOR &middot; Config</title><link rel=\"stylesheet\" href=\"/static/css/app.css\"><script src=\"/static/js/app.js\"></script></head><body><div class=\"sidebar\">\n  <div class=\"sidebar-top\">\n    <a href=\"/\" class=\"sidebar-logo\">\n      <div class=\"icon\">TC</div>\n      <span>T-CONNECTOR</span>\n    </a>\n    <button class=\"sidebar-toggle no-print\" onclick=\"toggleSidebar()\" aria-label=\"Replier le menu\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/></svg>\n    </button>\n  </div>\n  <ul class=\"sidebar-nav\"><li class=\"nav-label\">Principal</li><li><a href=\"/\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg></span><span class=\"label\">Dashboard</span></a></li><li><a href=\"/invoices\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg></span><span class=\"label\">Factures Sage</span></a></li><li><a href=\"/billing\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg></span><span class=\"label\">Facturation</span></a></li><li><a href=\"/pos\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg></span><span class=\"label\">Vente POS</span></a></li><li class=\"nav-label\">Gestion</li><li><a href=\"/clients\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg></span><span class=\"label\">Clients</span></a></li><li><a href=\"/sales\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><span class=\"label\">Historique</span></a></li><li><a href=\"/vendeurs\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span><span class=\"label\">Vendeurs</span></a></li><li><a href=\"/pending\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg></span><span class=\"label\">En attente</span></a></li><li><a href=\"/certified\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg></span><span class=\"label\">Certifiees</span></a></li><li><a href=\"/utilisateurs\" class=\"\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"label\">Utilisateurs</span></a></li><li><a href=\"/config\" class=\"active\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"label\">Config</span></a></li><li><a href=\"/logout\" class=\"logout-link\"><span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/></svg></span><span class=\"label\">Deconnexion</span></a></li></ul>\n  <div class=\"sidebar-foot\">\n    <div class=\"net-indicator\">\n      <span class=\"net-dot unknown\" id=\"net-dot\"></span>\n      <span id=\"net-label\" style=\"font-size:11px;font-weight:600\">...</span>\n    </div>\n  </div>\n</div>\n<div class=\"main-content\"><div class=\"topbar\"><div class=\"topbar-title\">Config</div><div class=\"topbar-actions\"><span class=\"user-chip\"><span class=\"ava\">A</span><span>admin@example.com<span style=\"color:#64748b;font-weight:500\"> &middot; Administrateur</span></span></span><a class=\"btn btn-sm btn-ghost no-print\" href=\"/compte/mot-de-passe\">Mot de passe</a><a class=\"btn btn-sm btn-ghost no-print\" href=\"/logout\">Deconnexion</a></div></div><script>window.CSRF_TOKEN=\"plKDfcq5Ba2nYxHaY9-Cfhm19ttV5NyiTJpbxjO1FpQ\";</script><div class=\"card\"><h2>Configuration</h2>\n<div class=\"tabs\">\n<button class=\"tab-btn active\" id=\"tab-btn-db\" onclick=\"switchTab('db')\">Base de Donnees</button>\n<button class=\"tab-btn\" id=\"tab-btn-sfec\" onclick=\"switchTab('sfec')\">API SFEC</button>\n<button class=\"tab-btn\" id=\"tab-btn-company\" onclick=\"switchTab('company')\">Entreprise</button>\n<button class=\"tab-btn\" id=\"tab-btn-sync\" onclick=\"switchTab('sync')\">Synchronisation</button>\n<button class=\"tab-btn\" id=\"tab-btn-validation\" onclick=\"switchTab('validation')\">Validation & Limites</button>\n<button class=\"tab-btn\" id=\"tab-btn-notif\" onclick=\"switchTab('notif')\">Notifications</button>\n<button class=\"tab-btn\" id=\"tab-btn-system\" onclick=\"switchTab('system')\">Systeme</button>\n</div>\n<div class=\"tab-content active\" id=\"tab-db\">\n<h2 style=\"margin-bottom:16px\">Base de donnees Sage 100</h2>\n<form id=\"form-db\" onsubmit=\"event.preventDefault();saveForm('form-db','/api/config/db')\">\n<div class=\"grid-2\">\n<div><label>Serveur</label><input type=\"text\" name=\"server\" value=\"\"></div>\n<div><label>Port</label><input type=\"number\" name=\"port\" value=\"1433\"></div>\n<div><label>Base de donnees</label><input type=\"text\" name=\"database\" value=\"\"><div class=\"desc\">Nom exact de la base Sage 100</div></div>\n<div><label>Utilisateur</label><input type=\"text\" name=\"user\" value=\"\"></div>\n<div><label>Mot de passe</label><input type=\"password\" name=\"password\" value=\"\"></div>\n<div><label>Connexion Windows</label><select name=\"trusted_connection\"><option value=\"false\" selected>Non</option><option value=\"true\" >Oui</option></select></div>\n<div><label>Chiffrer</label><select name=\"encrypt\"><option value=\"false\" selected>Non</option><option value=\"true\" >Oui</option></select></div>\n<div><label>Confiance certificat</label><select name=\"trust_server_certificate\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select></div>\n</div>\n<h2 style=\"margin-top:16px\">Pool & Timeouts</h2>\n<div class=\"grid-2\">\n<div><label>Connexions max</label><input type=\"number\" name=\"pool_max\" value=\"10\"></div>\n<div><label>Connexions min</label><input type=\"number\" name=\"pool_min\" value=\"2\"></div>\n<div><label>Idle timeout (ms)</label><input type=\"number\" name=\"pool_idle_timeout_ms\" value=\"30000\"></div>\n<div><label>Connection timeout (ms)</label><input type=\"number\" name=\"connection_timeout_ms\" value=\"15000\"></div>\n<div><label>Request timeout (ms)</label><input type=\"number\" name=\"request_timeout_ms\" value=\"30000\"></div>\n</div>\n<div style=\"margin-top:16px\">\n<button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button>\n<button type=\"button\" class=\"btn btn-success\" onclick=\"testDb()\">Tester la connexion</button>\n<div id=\"db-test\" style=\"margin-top:8px\"></div>\n</div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-sfec\">\n<h2 style=\"margin-bottom:16px\">Configuration API SFEC</h2>\n<form id=\"form-sfec\" onsubmit=\"event.preventDefault();saveForm('form-sfec','/api/config/sfec')\">\n<div class=\"grid-2\">\n<div><label>Cle API SFEC</label><input type=\"text\" name=\"api_key\" value=\"<SFEC_API_KEY>\"></div>\n<div><label>Environnement</label><select name=\"use_sandbox\"><option value=\"true\" selected>Sandbox (test)</option><option value=\"false\" >Production</option></select></div>\n<div><label>SFEC active</label><select name=\"enabled\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select></div>\n<div><label>Statut pour certification</label><select name=\"certify_status\">\n<option value=\"SAISI\" >SAISI</option>\n<option value=\"CONFIRME\" >CONFIRME</option>\n<option value=\"A COMPTABILISER\" selected>A COMPTABILISER</option>\n<option value=\"COMPTABILISE\" >COMPTABILISE</option>\n<option value=\"LETTRÉ\" >LETTRÉ</option></select></div>\n<div><label>URL Production</label><input type=\"text\" name=\"base_url\" value=\"https://api.sfec.gouv.cg\"></div>\n<div><label>URL Sandbox</label><input type=\"text\" name=\"sandbox_url\" value=\"https://sandbox.api.sfec.gouv.cg\"></div>\n</div>\n<div style=\"margin-top:16px\">\n<button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button>\n<button type=\"button\" class=\"btn btn-success\" onclick=\"testSfec()\">Tester la connexion SFEC</button>\n<div id=\"sfec-test\" style=\"margin-top:8px\"></div>\n</div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-company\">\n<h2 style=\"margin-bottom:16px\">Configuration Entreprise</h2>\n<form id=\"form-company\" onsubmit=\"event.preventDefault();saveForm('form-company','/api/config/company')\">\n<div class=\"grid-2\">\n<div><label>Forme juridique</label><input type=\"text\" name=\"legal_form\" value=\"\"></div>\n<div><label>N° RCCM</label><input type=\"text\" name=\"rc_number\" value=\"\"></div>\n<div><label>Capital social</label><input type=\"text\" name=\"capital\" value=\"\"></div>\n<div><label>Nom de l'entreprise</label><input type=\"text\" name=\"name\" value=\"\"></div>\n<div><label>NIU (Tax Number)</label><input type=\"text\" name=\"tax_number\" value=\"\"></div>\n<div><label>Adresse</label><input type=\"text\" name=\"address\" value=\"\"></div>\n<div><label>Ville</label><input type=\"text\" name=\"city\" value=\"\"></div>\n<div><label>Pays</label><input type=\"text\" name=\"country\" value=\"\"></div>\n<div><label>Telephone</label><input type=\"text\" name=\"phone\" value=\"\"></div>\n<div><label>Email</label><input type=\"email\" name=\"email\" value=\"\"></div>\n<div><label>Devise</label><select name=\"currency\"><option value=\"XAF\" selected>XAF (FCFA)</option><option value=\"USD\" >USD</option></select></div>\n</div>\n<h2 style=\"margin-top:16px\">Banque</h2>\n<div class=\"grid-2\">\n<div><label>Banque</label><input type=\"text\" name=\"bank_name\" value=\"\"></div>\n<div><label>Compte</label><input type=\"text\" name=\"bank_account\" value=\"\"></div>\n<div><label>IBAN</label><input type=\"text\" name=\"bank_iban\" value=\"\"></div>\n<div><label>SWIFT</label><input type=\"text\" name=\"bank_swift\" value=\"\"></div>\n</div>\n<h2 style=\"margin-top:16px\">Facturation</h2>\n<div class=\"grid-2\">\n<div><label>Prefixe facture</label><input type=\"text\" name=\"invoice_prefix\" value=\"INV-\"></div>\n<div><label>Numero suivant</label><input type=\"number\" name=\"invoice_next_number\" value=\"1\"></div>\n<div><label>Notes facture</label><input type=\"text\" name=\"invoice_notes\" value=\"\"></div>\n<div><label>Pied de page</label><input type=\"text\" name=\"invoice_footer\" value=\"\"></div>\n<div><label>Regime fiscal</label><input type=\"text\" name=\"tax_regime\" value=\"\"></div>\n<div><label>QR Code active</label><select name=\"qrcode_enabled\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select></div>\n</div>\n<div style=\"margin-top:16px\"><button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button></div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-sync\">\n<h2 style=\"margin-bottom:16px\">Synchronisation & Polling</h2>\n<form id=\"form-sync\" onsubmit=\"event.preventDefault();saveForm('form-sync','/api/config/sync')\">\n<div class=\"grid-2\">\n<div><label>Polling active</label><select name=\"polling_enabled\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select><div class=\"desc\">Active/desactive la synchro automatique</div></div>\n<div><label>Intervalle polling (ms)</label><input type=\"number\" name=\"polling_interval_ms\" value=\"30000\"><div class=\"desc\">Recommande: 30000 (30 secondes)</div></div>\n</div>\n<h2 style=\"margin-top:16px\">File d'attente</h2>\n<div class=\"grid-2\">\n<div><label>Concurrence max</label><input type=\"number\" name=\"max_concurrent\" value=\"5\"><div class=\"desc\">Certifications SFEC simultanees</div></div>\n<div><label>Retries max</label><input type=\"number\" name=\"max_retries\" value=\"4\"><div class=\"desc\">Nombre de tentatives en cas d'echec</div></div>\n<div><label>Delai retry (ms)</label><input type=\"number\" name=\"retry_base_delay_ms\" value=\"2000\"><div class=\"desc\">Delai de base entre les retries</div></div>\n<div><label>Taille max queue</label><input type=\"number\" name=\"max_queue_size\" value=\"10000\"></div>\n<div><label>Timeout job (ms)</label><input type=\"number\" name=\"job_timeout_ms\" value=\"60000\"></div>\n</div>\n<div style=\"margin-top:16px\"><button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button></div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-validation\">\n<h2 style=\"margin-bottom:16px\">Validation</h2>\n<form id=\"form-validation\" onsubmit=\"event.preventDefault();saveForm('form-validation','/api/config/validation')\">\n<div class=\"grid-2\">\n<div><label>Mode strict</label><select name=\"strict_mode\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select><div class=\"desc\">Verification stricte des donnees avant certification</div></div>\n<div><label>Tolerance montant</label><input type=\"number\" name=\"tolerance_amount\" value=\"0.01\" step=\"0.01\"><div class=\"desc\">Ecart autorise entre les totaux</div></div>\n</div>\n<h2 style=\"margin-top:16px\">Limites API SFEC</h2>\n<div class=\"grid-2\">\n<div><label>Maximum journalier</label><input type=\"number\" name=\"daily_max\" value=\"2500\"><div class=\"desc\">Nombre max de certifications par jour</div></div>\n<div><label>Maximum par minute</label><input type=\"number\" name=\"per_minute_max\" value=\"100\"></div>\n<div><label>Seuil d'alerte (%)</label><input type=\"number\" name=\"alert_threshold_percent\" value=\"80\"><div class=\"desc\">Declenche une alerte a ce %</div></div>\n</div>\n<div style=\"margin-top:16px\"><button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button></div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-notif\">\n<h2 style=\"margin-bottom:16px\">Notifications</h2>\n<form id=\"form-notif\" onsubmit=\"event.preventDefault();saveForm('form-notif','/api/config/notifications')\">\n<div class=\"grid-2\">\n<div><label>Notifications activees</label><select name=\"enabled\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select></div>\n</div>\n<h2 style=\"margin-top:16px\">Evenements</h2>\n<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px\">\n<div><input type=\"checkbox\" name=\"evt_synced\" value=\"invoice:synced\" checked> Facture synchro</div>\n<div><input type=\"checkbox\" name=\"evt_val_error\" value=\"invoice:validation_error\" checked> Erreur validation</div>\n<div><input type=\"checkbox\" name=\"evt_dlq\" value=\"queue:dlq_added\" checked> File d'attente</div>\n<div><input type=\"checkbox\" name=\"evt_db_fail\" value=\"db:connection_failed\" checked> Echec connexion DB</div>\n<div><input type=\"checkbox\" name=\"evt_db_err\" value=\"db:polling_error\" checked> Erreur polling</div>\n</div>\n<div style=\"margin-top:16px\"><button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button></div>\n</form></div>\n<div class=\"tab-content\" id=\"tab-system\">\n<h2 style=\"margin-bottom:16px\">Systeme & Dashboard</h2>\n<form id=\"form-system\" onsubmit=\"event.preventDefault();saveForm('form-system','/api/config/system')\">\n<div class=\"grid-2\">\n<div><label>Niveau de log</label><select name=\"log_level\">\n<option value=\"debug\" >Debug</option>\n<option value=\"info\" selected>Info</option>\n<option value=\"warning\" >Warning</option>\n<option value=\"error\" >Error</option></select></div>\n<div><label>Port dashboard</label><input type=\"number\" name=\"port\" value=\"3000\"></div>\n<div><label>Auth active</label><select name=\"auth_enabled\"><option value=\"true\" selected>Oui</option><option value=\"false\" >Non</option></select></div>\n<div><label>Email login</label><input type=\"email\" name=\"login_email\" value=\"admin@example.com\"></div>\n<div><label>Mot de passe login</label><input type=\"password\" name=\"login_password\" value=\"CHANGE-ME\"></div>\n<div><label>Session secret</label><input type=\"text\" name=\"session_secret\" value=\"CHANGE-ME-IN-PRODUCTION\"></div>\n<div><label>Duree session (heures)</label><input type=\"number\" name=\"session_max_age_hours\" value=\"24\"></div>\n<div><label>Host</label><input type=\"text\" name=\"host\" value=\"0.0.0.0\"></div>\n</div>\n<div style=\"margin-top:16px\">\n<button type=\"submit\" class=\"btn btn-primary\">Sauvegarder</button>\n<button type=\"button\" class=\"btn btn-warning\" onclick=\"applyConfig()\" style=\"margin-left:8px\">Appliquer (recharger)</button>\n</div>\n</form>\n<h2 style=\"margin-top:24px\">Export / Import Configuration</h2>\n<div style=\"margin-top:8px\">\n<a href=\"/api/config/export\" class=\"btn btn-success\" download=\"config.json\">Exporter config.json</a>\n<button type=\"button\" class=\"btn btn-primary\" onclick=\"document.getElementById('import-file').click()\" style=\"margin-left:8px\">Importer config.json</button>\n<input type=\"file\" id=\"import-file\" accept=\".json\" style=\"display:none\" onchange=\"importConfig(this)\">\n</div>\n<div id=\"import-status\" style=\"margin-top:8px\"></div>\n</div>\n<script>\nfunction testDb(){document.getElementById(\"db-test\").textContent=\"Test en cours...\";api(\"GET\",\"/api/db/test\").then(function(d){document.getElementById(\"db-test\").innerHTML=d.ok?'<span class=\"badge badge-ok\">Connecte: '+d.table_map.documents+'</span>':'<span class=\"badge badge-err\">'+d.error+'</span>'})}\nfunction testSfec(){document.getElementById(\"sfec-test\").textContent=\"Test en cours...\";api(\"GET\",\"/api/sfec/test\").then(function(d){document.getElementById(\"sfec-test\").innerHTML=d.connected?'<span class=\"badge badge-ok\">Connecte: '+d.url+'</span>':'<span class=\"badge badge-err\">Deconnecte</span>'})}\nfunction applyConfig(){showToast(\"Application de la configuration...\",\"info\");api(\"POST\",\"/api/config/reload\").then(function(d){showToast(d.message||\"OK\",\"ok\");}).catch(function(e){showToast(\"Erreur: \"+e,\"err\")})}\nfunction importConfig(input){var file=input.files[0];if(!file)return;var reader=new FileReader();reader.onload=function(e){try{var cfg=JSON.parse(e.target.result);document.getElementById(\"import-status\").textContent=\"Importation...\";api(\"POST\",\"/api/config/import\",cfg).then(function(d){if(d.ok){showToast(\"Config importee! Rechargement...\",\"ok\");setTimeout(function(){location.reload()},1500)}else{showToast(\"Erreur: \"+d.error,\"err\")}})}catch(err){showToast(\"JSON invalide: \"+err,\"err\")}};reader.readAsText(file)}\n</script></div>\n<div class=\"alert-zone\" id=\"alert-zone\" aria-live=\"polite\"></div>\n</body></html>",
